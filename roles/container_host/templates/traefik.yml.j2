#jinja2: trim_blocks:False
# {{ ansible_managed }}
api:
  insecure: true
  dashboard: {{ podman_traefik_dashboard }}

http:
  routers:
    {%- if podman_traefik_dashboard %}
    dashboard:
      rule: PathPrefix("/dashboard")
      service: api@internal
    {%- endif %}

entryPoints:
  {%- if podman_traefik_http %}
  web:
    address: ":80"
    {%- if podman_traefik_http_proxies %}
    forwardedHeaders:
      trustedIPs:
      {%- for proxy in podman_traefik_http_proxies %}
        - {{ proxy }}
      {%- endfor -%}
    {% endif %}
  {% endif %}

  {%- if podman_traefik_https %}
  websecure:
    address: ":443"
    http:
      tls: {}
    {% if podman_traefik_https_proxies %}
    forwardedHeaders:
      trustedIPs:
      {%- for proxy in podman_traefik_https_proxies %}
        - {{ proxy }}
      {%- endfor -%}
    {% endif %}
  {% endif %}
providers:
  docker:
    endpoint: "unix:///var/run/docker.sock"
    exposedByDefault: false
